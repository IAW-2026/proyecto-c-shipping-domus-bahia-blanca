// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Turno {
  id                       String   @id @default(uuid())
  
  propiedadId              String //Necesito la id para luego solicitar lo siguiente
  
  direccion                String?
  latitud                  Float?
  longitud                 Float?                 
  nombrePropiedad          String? //No me dejaba migrarlo si no lo ponia con ?
  
  compradorId              String

  nombreComprador          String? //No me dejaba migrarlo si no lo ponia con ?

  vendedorId               String
  nombreInmobiliaria       String?

  agenteId                 String?

  fechaHoraSolicitada      DateTime? //para que hora esta solicitado el turno

  estado                   EstadoTurno

  observaciones            String?

  estadoComprador EstadoTurnoComprador @default(PENDIENTE)
  
  respuestaAgenteEn        DateTime?
  respuestaVendedorEn      DateTime?

  creadoEn                 DateTime @default(now()) //cuando se crea el turno en el sistema

  agente AgenteInmobiliario? @relation(fields: [agenteId], references: [id])

  historial HistorialTurno[]
}

model AgenteInmobiliario {
  id               String   @id
  
  nombreCompleto   String

  nombreInmobiliaria String?
  
  email            String   @unique
  
  telefono         String?

  vendedorId       String? //inmobiliariaID

  estado           EstadoAgente @default(PENDIENTE)

  turnos           Turno[]
  
  
}

model HistorialTurno {
  id           String      @id @default(uuid())
  turnoId      String
  estado       EstadoTurno
  detalle      String?
  realizadoPor String
  creadoEn     DateTime    @default(now())

  turno        Turno              @relation(fields: [turnoId], references: [id])
}

enum EstadoTurnoComprador {
  PENDIENTE
  CONFIRMADO
  CANCELADO
  COMPLETADO
}

enum EstadoTurno {
  PENDIENTE_AGENTE
  PRE_ACEPTADO
  RECHAZADO_VENDEDOR
  CONFIRMADO
  CANCELADO
  COMPLETADO
}

enum EstadoAgente {
  PENDIENTE
  ACEPTADO
  RECHAZADO
}

