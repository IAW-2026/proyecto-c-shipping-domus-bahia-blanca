// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "postgresql"
}

model Turno {
  id                       String   @id @default(uuid())
  
  propiedadId              String
  
  compradorId              String

  nombreComprador          String? //No me dejaba migrarlo si no lo ponia con ?

  agenteId                 String?

  fechaHoraSolicitada      DateTime? //para que hora esta solicitado el turno

  estado                   EstadoTurno

  observaciones            String?

  estadoComprador EstadoTurnoComprador @default(PENDIENTE)
  
  respuestaAgenteEn        DateTime?
  respuestaVendedorEn      DateTime?

  creadoEn                 DateTime @default(now()) //cuando se crea el turno en el sistema

  propiedad Propiedad @relation(fields: [propiedadId], references: [id])

  agente AgenteInmobiliario? @relation(fields: [agenteId], references: [id])
}

model Propiedad {
  id                  String @id
  nombrePropiedad     String?
  direccion           String?
  latitud             Float?
  longitud            Float?
  vendedorId          String
  nombreInmobiliaria  String?

  turnos              Turno[]

  @@index([vendedorId])
}

model AgenteInmobiliario {
  id               String   @id
  
  nombreCompleto   String

  nombreInmobiliaria String?
  
  email            String   @unique
  
  telefono         String?

  vendedorId       String? //inmobiliariaID

  estado           EstadoAgente @default(PENDIENTE)

  turnos           Turno[]
  
  
}

enum EstadoTurnoComprador {
  PENDIENTE
  CONFIRMADO
  CANCELADO
  COMPLETADO
}

enum EstadoTurno {
  PENDIENTE_AGENTE
  PRE_ACEPTADO
  RECHAZADO_VENDEDOR
  CONFIRMADO
  CANCELADO
  COMPLETADO
}

enum EstadoAgente {
  PENDIENTE
  ACEPTADO
  RECHAZADO
}
