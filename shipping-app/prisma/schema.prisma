enum EstadoTurnoComprador {
  PENDIENTE
  CONFIRMADO
  CANCELADO
  COMPLETADO
}

enum EstadoTurno {
  PENDIENTE_AGENTE
  PRE_ACEPTADO
  RECHAZADO_VENDEDOR
  CONFIRMADO
  CANCELADO
  COMPLETADO
}

enum EstadoAgente {
  PENDIENTE
  ACEPTADO
  RECHAZADO
}

