// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Turno {
  id                       String   @id @default(uuid())
  propiedadId              String
  compradorId              String
  vendedorId               String
  agenteId                 String?

  fechaHoraSolicitada      DateTime?
  fechaHoraConfirmada      DateTime?

  estado                   EstadoTurno

  observaciones            String?

  estadoComprador EstadoTurnoComprador @default(PENDIENTE)
  
  respuestaAgenteEn        DateTime?
  respuestaVendedorEn      DateTime?

  creadoEn                 DateTime @default(now())

  agente AgenteInmobiliario? @relation(fields: [agenteId], references: [id])

}

model AgenteInmobiliario {
  id               String   @id @default(uuid())

  clerkUserId      String   @unique
  
  nombreCompleto   String

  nombreInmobiliaria String?
  
  email            String   @unique
  
  telefono         String?

  vendedorId       String? //vendedorID

  estado           EstadoAgente @default(PENDIENTE)

  turnos           Turno[]
}
